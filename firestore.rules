rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: each user can only read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Bookings: authenticated users can read all; write/delete requires auth
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.guestName is string
        && request.resource.data.roomNumber is number
        && request.resource.data.roomNumber >= 1
        && request.resource.data.roomNumber <= 7;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Delete requests: any authenticated user can create & read;
    // update (approve/reject) and delete (dismiss) also require auth
    match /deleteRequests/{requestId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.bookingId is string
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Settings: any authenticated user can read; write requires auth
    // (pricing config, etc.)
    match /settings/{settingId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Notifications: any authenticated user can read & write
    // (price change alerts, etc. — admin dismisses/reads)
    match /notifications/{notifId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    // Utility Bills: authenticated users can read and write
    match /utilityBills/{billId} {
      allow read, write: if request.auth != null;
    }

    // Employees: authenticated users can read and write
    match /employees/{employeeId} {
      allow read, write: if request.auth != null;
    }

    // Employee Attendance: authenticated users can read and write
    match /employeeAttendance/{attendanceId} {
      allow read, write: if request.auth != null;
    }

    // Employee Salary Payments: authenticated users can read and write
    match /employeeSalaryPayments/{paymentId} {
      allow read, write: if request.auth != null;
    }
  }
}
